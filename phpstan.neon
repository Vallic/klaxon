includes:
  - phpstan-baseline.neon

parameters:
  level: 5

  # Analyse at the floor composer.json declares, not at whatever the machine
  # running this happens to have. Readonly promoted properties on a class
  # whose parent uses DependencySerializationTrait are only legal from 8.4,
  # and this module is 8.4 and later - so say so here rather than find out
  # from a job running something older.
  phpVersion: 80400

  fileExtensions:
    - php
    - module
    - inc
    - install

  # Core's docblocks are looser than what the code actually returns — an
  # entity storage says EntityInterface and hands back the concrete class —
  # so an instanceof that PHPStan calls redundant is genuinely load-bearing.
  treatPhpDocTypesAsCertain: false

  reportUnmatchedIgnoredErrors: false

  ignoreErrors:
    # new static() is how Drupal builds plugins and forms, everywhere.
    - '#^Unsafe usage of new static#'
